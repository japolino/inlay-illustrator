{
  "name": "inlay-illustrator",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit",
    "eval:sidecars": "bun run src/evals/sidecar-sim/runner.ts",
    "eval:images": "bun run src/evals/image-prompt-study/runner.ts",
    "eval:images:vision": "bun run src/evals/image-prompt-study/vision-runner.ts",
    "eval:images:report": "bun run src/evals/image-prompt-study/report-runner.ts",
    "verify": "bun run test && bun run typecheck",
    "build": "bun run typecheck:build && bun build ./src/backend.ts ./src/frontend.ts --outdir ./dist --target browser --format esm"
  },
  "devDependencies": {
    "@google/genai": "^2.13.0",
    "bun-types": "1.3.14",
    "lumiverse-spindle-types": "0.6.2",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  }
}
