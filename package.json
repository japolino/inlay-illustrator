{
  "name": "inlay-illustrator",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "css": "bun run src/build/build-css.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit",
    "dev:mcp": "bun run src/dev/lumiverse-mcp/server.ts",
    "dev:mcp:smoke": "bun run src/dev/lumiverse-mcp/smoke.ts",
    "verify": "bun run test && bun run typecheck",
    "build": "bun run css && bun run typecheck:build && bun build ./src/backend.ts ./src/frontend.tsx --outdir ./dist --target browser --format esm"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/cli": "4.3.3",
    "bun-types": "1.3.14",
    "happy-dom": "^20.14.5",
    "lumiverse-spindle-types": "0.6.37",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "preact": "^11.0.0",
    "tailwind-merge": "^3.7.0"
  }
}
