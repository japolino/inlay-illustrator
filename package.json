{
  "name": "inlay-illustrator",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "test": "bun test --isolate",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit",
    "verify": "bun run test && bun run typecheck",
    "build": "bun run typecheck:build && bun build ./src/backend.ts ./src/frontend.ts --outdir ./dist --target browser --format esm --minify"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "lumiverse-spindle-types": "0.6.2",
    "typescript": "7.0.2"
  }
}
