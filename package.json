{
  "name": "inlay-illustrator",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit",
    "dev:mcp": "bun run src/dev/lumiverse-mcp/server.ts",
    "dev:mcp:smoke": "bun run src/dev/lumiverse-mcp/smoke.ts",
    "verify": "bun run test && bun run typecheck",
    "build": "bun run typecheck:build && bun build ./src/backend.ts ./src/frontend.ts --outdir ./dist --target browser --format esm"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bun-types": "1.3.14",
    "lumiverse-spindle-types": "0.6.37",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  }
}
