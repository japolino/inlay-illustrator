{
  "version": "0.10.0",
  "name": "Inlay Illustrator",
  "identifier": "inlay_illustrator",
  "author": "japolino",
  "github": "https://github.com/japolino/inlay-illustrator",
  "homepage": "https://github.com/japolino/inlay-illustrator",
  "description": "Scene illustration and character asset manager for Lumiverse: plans pictures for chat replies and renders them with NovelAI or ComfyUI.",
  "permissions": [
    "generation",
    "interceptor",
    "image_gen",
    "chat_mutation",
    "images",
    "chats",
    "characters",
    "personas",
    "world_books",
    "regex_scripts",
    "app_manipulation",
    "ui_panels"
  ],
  "requested_capabilities": [
    "base64_decode"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "0.1.0"
}
