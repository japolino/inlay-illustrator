{
  "version": "0.9.1",
  "name": "Inlay Illustrator",
  "identifier": "inlay_illustrator",
  "author": "japolino",
  "github": "https://github.com/japolino/inlay-illustrator",
  "homepage": "https://github.com/japolino/inlay-illustrator",
  "description": "Lightboard 4.5.3 scene and comic illustration for Lumiverse, with editable prompts, saved styles, and dedicated character reference snapshots.",
  "permissions": [
    "generation",
    "interceptor",
    "image_gen",
    "chat_mutation",
    "images",
    "chats",
    "characters",
    "personas",
    "world_books"
  ],
  "requested_capabilities": [
    "base64_decode"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "0.1.0"
}
