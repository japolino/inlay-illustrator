{
 "cases": [
  {
   "input": "{\"a\":1}",
   "expected": {
    "ok": {
     "a": 1
    }
   }
  },
  {
   "input": "```json\n{\"a\":[1,2]}\n```",
   "expected": {
    "ok": {
     "a": [
      1,
      2
     ]
    }
   }
  },
  {
   "input": "```\n[1,2,3]\n```",
   "expected": {
    "ok": [
     1,
     2,
     3
    ]
   }
  },
  {
   "input": "Sure! Here you go: {\"x\": \"y\"} hope it helps",
   "expected": {
    "ok": {
     "x": "y"
    }
   }
  },
  {
   "input": "first {\"a\":1} then {\"b\":2}",
   "expected": {
    "ok": {
     "b": 2
    }
   }
  },
  {
   "input": "{\"a\":1} and broken {\"b\":",
   "expected": {
    "ok": {
     "a": 1
    }
   }
  },
  {
   "input": "text with \"{not json}\" then {\"ok\":true}",
   "expected": {
    "ok": {
     "ok": true
    }
   }
  },
  {
   "input": "{\"s\":\"brace } inside { string\",\"e\":\"esc \\\" quote\"}",
   "expected": {
    "ok": {
     "s": "brace } inside { string",
     "e": "esc \" quote"
    }
   }
  },
  {
   "input": "prefix [1, {\"a\": \"]\"}] suffix",
   "expected": {
    "ok": [
     1,
     {
      "a": "]"
     }
    ]
   }
  },
  {
   "input": "",
