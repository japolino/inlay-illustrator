   "expected": {
    "ok": 42
   }
  },
  {
   "input": "\"str\"",
   "expected": {
    "ok": "str"
   }
  },
  {
   "input": "null",
   "expected": {
    "ok": null
   }
  },
  {
   "input": "```JSON\n{\"upper\":true}\n```",
   "expected": {
