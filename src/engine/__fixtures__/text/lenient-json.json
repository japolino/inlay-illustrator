    }
   }
  },
  {
   "input": "   ",
   "expected": {
    "error": {
     "name": "AnalyzerClientError",
     "message": "Analyzer did not return JSON: ",
     "code": "ANALYZER_JSON_PARSE",
     "analyzerRaw": ""
    }
   }
  },
  {
   "input": "no json at all",
   "expected": {
    "error": {
     "name": "AnalyzerClientError",
     "message": "Analyzer did not return JSON: no json at all",
