     "analyzerRaw": "no json at all"
    }
   }
  },
  {
   "input": "{\"outer\": {\"inner\": [1, 2, {\"deep\": \"}\"}]}} trailing",
   "expected": {
    "ok": {
     "outer": {
      "inner": [
       1,
       2,
       {
        "deep": "}"
       }
      ]
     }
    }
   }
  },
  {
   "input": "{bad json} {\"good\": 1} [also, bad]",
   "expected": {
    "ok": {
