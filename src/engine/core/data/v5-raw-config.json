{
 "schema": "novelai-v5-scene-graph",
 "revision": 1,
 "analysisPresets": {
  "scene": {
   "default": {
    "instruction": "Write Camera once per illustration and only for camera position, one validated scene or body reference, and viewing direction. Use a scene reference when uncertain. Never repeat placement, action, Interaction, pose, body state, fluid, clothing, emotion, location content, or past events.",
    "presentation": {
     "label": "삽화",
     "description": "장면의 흐름에 맞춰 AI가 자유롭고 다양한 연출을 적용합니다.",
     "experimental": false
    }
   },
   "options": [
    {
     "id": "pov",
     "instruction": "Show the scene through the persona's eyes, maintaining their eye level, gaze direction, and viewing distance. Never switch to an external or another actor's viewpoint. In the persona's pose description, include only visible hand and arm actions in the current image or panel, including contact, support, or object handling. Keep these actions consistent with the first-person view; leave the description empty when no hands or arms are visible or no action needs clarification. Do not describe the persona's face, appearance, clothing, whole-body pose, or unseen body parts. Frame other present actors and their interactions clearly within a plausible field of view.",
     "variables": {
      "preset.camera.viewpoint": "persona_first_person",
      "preset.persona.visibility": "partial",
      "preset.actor.coverage": "all_present"
     },
     "controls": [
      {
       "id": "hands",
       "label": "POV hands 필수",
       "defaultEnabled": true,
       "variables": {
        "preset.persona.hands": "required"
       },
       "instructionSuffix": "POV hands are required in every illustration: frame the persona's hands or arms visibly and select framing.presence option pov_hands on the persona Actor Detail, even when the optional-selection guidance above would otherwise leave it unselected."
      }
     ],
     "presentation": {
      "label": "pov 연출",
      "description": "페르소나의 시야를 기준으로 장면을 1인칭 구도로 연출합니다. 다른 인물이 등장해도 시점은 페르소나에게 유지됩니다.",
      "experimental": false
     }
    },
    {
     "id": "ensemble",
     "instruction": "Compose all actors confirmed present at the depicted time and place together, including quiet observers and non-human participants. Preserve established presence within a continuous scene unless departure is indicated. Widen the view or adjust spacing and depth to keep everyone distinguishable and interactions readable. Do not split the scene solely because of actor count, combine separate scenes, or add participants based only on mentions or candidate records.",
     "variables": {
      "preset.actor.coverage": "all_present"
     },
     "presentation": {
      "label": "다인 연출",
      "description": "현재 장면에 실제로 참여하는 인물들을 가능한 한 하나의 이미지에 함께 배치하고, 인물 간 관계와 상호작용을 중심으로 연출합니다.",
      "experimental": false
     }
    },
    {
     "id": "comic",
     "instruction": "Render each requested illustration as one coherent manga page. Let the scene's action, emotion, timing, and reveal drive bold variation in panel scale, shape, overlap, camera, focus, spacing, and visual hierarchy instead of defaulting to a uniform row, column, stack, or grid. Panels and Actors may break, overlay, or span boundaries when that strengthens the presentation. Keep the reading flow unmistakable even when the page is asymmetric, layered, or non-linear. Use only as many meaningful panels as the scene needs, and do not force color or monochrome treatment.",
     "variables": {
      "preset.presentation.mode": "comic_page",
      "preset.presentation.orientation": "free"
     },
     "controls": [
      {
       "id": "frame",
       "label": "프레임",
       "defaultEnabled": true,
       "defaultValue": 0,
       "presentation": "segmented",
       "instructionPosition": "before-preset",
       "variables": {},
       "valueOptions": [
        {
         "value": 0,
         "label": "자유",
         "variables": {
          "preset.presentation.orientation": "free"
         },
         "instructionSuffix": "Frame Decision: Before composing any comic panels, independently choose either a portrait 832 × 1216 pixel frame or a landscape 1216 × 832 pixel frame for each illustration from its scene, action, emotion, timing, and reveal. Commit to that frame first, then compose the page and every panel within it. This frame decision is the highest-priority comic composition rule; other comic directions must fit the chosen frame. Do not use a square frame or let separate image-ratio preferences replace this decision."
        },
        {
         "value": 1,
         "label": "세로",
         "variables": {
          "preset.presentation.orientation": "portrait"
         },
         "instructionSuffix": "Frame Decision: Before composing any comic panels, fix every illustration to a portrait 832 × 1216 pixel frame, then compose the page and every panel within it. This frame decision is the highest-priority comic composition rule; other comic directions must fit this frame. Do not let separate image-ratio preferences replace it."
        },
        {
         "value": 2,
         "label": "가로",
         "variables": {
          "preset.presentation.orientation": "landscape"
         },
         "instructionSuffix": "Frame Decision: Before composing any comic panels, fix every illustration to a landscape 1216 × 832 pixel frame, then compose the page and every panel within it. This frame decision is the highest-priority comic composition rule; other comic directions must fit this frame. Do not let separate image-ratio preferences replace it."
        }
       ]
      },
      {
       "id": "speech-bubble",
       "label": "말풍선",
       "defaultEnabled": true,
       "variables": {
        "preset.dialogue.mode": "source_speech_bubble"
       }
      }
     ],
     "presentation": {
      "label": "카툰 연출",
      "description": "하나의 장면을 여러 만화 컷으로 구성하고, 인물의 행동과 감정을 컷의 흐름에 따라 생동감 있게 연출합니다.",
      "experimental": false
     }
    }
   ]
  },
  "imageRatio": {
   "default": {
    "instruction": "Choose from visual flow, placement, action, gaze, environment, framing, crop, and negative space, never Actor count alone. If visible upper bodies align side by side as the main composition, choose sizeId 1. For parallel lying Actors, choose sizeId 1 when viewed from above; otherwise choose sizeId 2.",
    "presentation": {
     "label": "기본",
     "description": "Choose from visual flow, placement, action, gaze, environment, framing, crop, and negative space, never Actor count alone. If visible upper bodies align side by side as the main composition, choose sizeId 1. For parallel lying Actors, choose sizeId 1 when viewed from above; otherwise choose sizeId 2.",
     "experimental": false
    }
   },
   "unspecified": {
    "instruction": "Choose the sizeId that best fits the current illustration from the allowed candidates. Apply no additional aspect-ratio preference.",
    "allowedSizeIds": [
     1,
     2,
     5
    ],
    "presentation": {
     "label": "미지정",
     "description": "별도 비율 선호 없이 선택한 sizeId 후보 안에서 장면에 가장 적합한 크기를 결정합니다.",
     "experimental": false
    }
   }
  }
 },
