 "modifierLibrary": {
  "freeTags": [
   {
    "id": "actor.free.placement",
    "subjects": [
     "actor"
    ],
    "order": 99,
    "instruction": "Return short English spatial-relation tags locating this occurrence by depth, environmental landmarks, or occlusion: e.g. in the foreground, partially behind a pillar. Each tag adds one spatial fact beyond center, facing, and the established pose or Interaction. Use a clear scene landmark or visible reference; omit when no additional spatial fact is needed."
   },
   {
    "id": "scene.free.location",
    "subjects": [
     "global"
    ],
    "order": 90,
    "instruction": "Return environment tags."
   },
   {
    "id": "scene.free.object",
    "subjects": [
     "global"
    ],
    "order": 91,
    "instruction": "Return tags for visible background or environmental objects not held or used by a specific Actor. Do not repeat objects assigned to actor.free.object, clothing, or accessories already represented by outfit data."
   },
   {
    "id": "actor.free.object",
    "subjects": [
     "actor"
    ],
    "order": 101,
    "instruction": "Return tags identifying visible objects held or directly used by this Actor occurrence and their distinguishing appearance. Do not repeat worn clothing, accessories, or items already represented by outfit data. Put grip, contact, support, and manner of use in poseInstruction; do not repeat scene.free.object background objects."
   }
  ],
  "naturalLanguage": [
   {
    "id": "scene.text.location",
    "subjects": [
     "global"
    ],
    "order": 90,
    "instruction": "Add spatial structure, materials, or environmental features beyond the location tags. Use less when sufficient."
   },
   {
    "id": "actor.text.pose",
    "subjects": [
     "actor"
    ],
    "order": 101,
    "instruction": "Describe this Actor occurrence's visible pose, independent action, and contribution to bound interactions together in poseInstruction. Include visible object handling: how this Actor grips, supports, carries, or uses an object. Preserve contact, direction, and support that selected tags do not express; leave object identity and appearance to object tags and do not repeat outfit or accessory descriptions. Include only what is visible in this image or panel; do not copy details from other occurrences or repeat tags or panel composition. Use less when sufficient."
   },
   {
    "id": "actor.text.dialogue",
    "subjects": [
     "actor"
    ],
    "order": 104,
    "instruction": "Return only `speech bubble, text:<source dialogue>` for direct speech in the current message, attached to the speaking Actor occurrence; assign each utterance once. Preserve source language and script; no invention, translation, romanization, or language tag. If dialogue exceeds 40 characters including spaces, summarize to one clause of at most 30 characters without adding facts; exclude the prefix from counts. Omit when no direct speech exists.",
    "language": "source_verbatim"
   },
   {
    "id": "scene.text.page",
    "subjects": [
     "global"
    ],
    "order": 109,
    "instruction": "Return one integrated page composition: visual hierarchy, panel boundaries, rhythm, and reading flow. Realize selected page planning as relative panel sizes, positions, and boundary relationships in ordinary spatial prose, without IDs or encoded labels. Writing budget: 60 + 50 per declared panel characters including spaces; use less when sufficient. Reading order does not imply linear layout. Panel instructions realize their Camera design; Actor Detail realizes the visible subjects."
   },
   {
    "id": "scene.text.camera",
    "subjects": [
     "global"
    ],
    "order": 110,
    "instruction": "Return camera position, an unambiguous validated scene or body reference, and viewing direction. When referring to characters, use brief visual or spatial descriptions consistent with their established appearance and placement, never names, aliases, or Actor IDs."
   }
  ],
